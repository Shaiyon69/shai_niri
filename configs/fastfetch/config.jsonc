{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/logo.ansi",
        "width": 32,
        "height": 12,
        "padding": { "top": 0, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "brightColor": false,
        "color": { "keys": "90", "title": "bright_white" },
        "key": { "width": 11 }
    },
    "modules": [
        "break",
        { "type": "title", "format": "{user-name}@{host-name}" },
        { "type": "separator", "string": "\u2500" },
        { "type": "os", "key": "  os", "format": "{name}" },
        { "type": "kernel", "key": "  kernel", "format": "{release}" },
        { "type": "wm", "key": "  wm", "format": "{pretty-name}" },
        { "type": "shell", "key": "  shell", "format": "{pretty-name} {version}" },
        { "type": "packages", "key": "  pkgs" },
        { "type": "uptime", "key": "  uptime" },
        { "type": "memory", "key": "  memory", "format": "{used} / {total}" },
        "break",
        { "type": "colors", "key": " ", "symbol": "circle" }
    ]
}
